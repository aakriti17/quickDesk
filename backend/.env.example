# ============================================================
# QuickDesk Backend Configuration Template
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# ============================================================

# Database URL (SQLite async connection)
DATABASE_URL=sqlite+aiosqlite:///./quickdesk.db

# Security & Session Token Signing Key
# In production, replace with a strong random secret:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-secure-random-secret-key

# Debug Mode (True/False)
DEBUG=True

# Public Application URL
# Leave empty to automatically detect and use your local LAN IP (e.g. http://192.168.1.5:9000)
# When exposing through ngrok, Cloudflare Tunnel, or a public domain, set it here:
# PUBLIC_APP_URL=https://your-custom-subdomain.ngrok-free.dev
PUBLIC_APP_URL=

# Server Port
PORT=9000
