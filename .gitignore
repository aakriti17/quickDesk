# ============================================================
# QuickDesk - Root .gitignore
# ============================================================

# Environments & Secret Configuration
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
/build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Database / SQLite
*.db
*.sqlite
*.sqlite3
quickdesk.db

# Node.js / Frontend
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js
.npm

# Retain pre-built frontend distribution for zero-config one-click startup
!frontend/build/
!frontend/build/**
# frontend/build/

# IDE & Editor Configurations
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.project
.settings/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Testing & Coverage
.coverage
htmlcov/
.pytest_cache/
